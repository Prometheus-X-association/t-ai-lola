{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}admin.index.title{% endtrans %}
{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>{% trans %}admin.index.heading{% endtrans %}</h1>

    <p>{% trans %}admin.index.message{% endtrans %}</p>

    <ul>
        <li>
            {% trans %}admin.index.controller_file{% endtrans %} :
            <code>src/Controller/AdminController.php</code>
        </li>
        <li>
            {% trans %}admin.index.template_file{% endtrans %} :
            <code>templates/admin/index.html.twig</code>
        </li>
    </ul>
</div>
{% endblock %}
