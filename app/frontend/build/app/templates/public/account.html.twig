{% extends "public/base/layout.html.twig" %}

{% block title %}
    {% trans %}public.account.title{% endtrans %}
{% endblock %}

{% block content %}
    <div class="login-wrap account-wrap" id="login-wrap">
        <div class="login-html account-panel">
            <h2>Lola</h2>
            <blockquote class="smallcaps">Laboratoire Ouvert en Learning Analytics</blockquote>

            <div class="login-form">
                <div class="for-account">
                    {% for flashError in app.flashes('verify_email_error') %}
                        <div class="alert alert-danger" role="alert">{{ flashError }}</div>
                    {% endfor %}

                    {{ form_start(form) }}

                    <div class="group">
                        <label for="email" class="label">
                            {% trans %}public.account.email{% endtrans %}
                        </label>
                        {{ form_widget(form.email, { 'attr': {'class': 'input'} }) }}
                        <div class="form-error">
                            {{ form_errors(form.email) }}
                        </div>
                    </div>

                    <div class="group">
                        <label for="firstname" class="label">
                            {% trans %}public.account.firstname{% endtrans %}
                        </label>
                        {{ form_widget(form.firstname, { 'attr': {'class': 'input'} }) }}
                        <div class="form-error">
                            {{ form_errors(form.firstname) }}
                        </div>
                    </div>

                    <div class="group">
                        <label for="lastname" class="label">
                            {% trans %}public.account.lastname{% endtrans %}
                        </label>
                        {{ form_widget(form.lastname, { 'attr': {'class': 'input'} }) }}
                        <div class="form-error">
                            {{ form_errors(form.lastname) }}
                        </div>
                    </div>

                    <div class="group">
                        <label for="password" class="label">
                            {% trans %}public.account.password{% endtrans %}
                        </label>
                        {{ form_widget(form.plainPassword, { 'attr': {'class': 'input'} }) }}
                        <div class="form-error">
                            {{ form_errors(form.plainPassword) }}
                        </div>
                    </div>

                    <div class="group account-terms">
                        <a href="#" id="link_terms" class="label" data-toggle="modal" data-target="#terms">
                            {% trans %}public.account.voir_conditions{% endtrans %}
                        </a>

                        <div class="terms-divider"></div>

                        <div class="account-terms-check">
                            {{ form_widget(form.agreeTerms, { 'attr': {'class': 'account-terms-checkbox'} }) }}
                            {{ form_label(form.agreeTerms, 'public.account.accepter_conditions', { 'label_attr': {'class': 'account-terms-label'} }) }}
                        </div>

                        <div class="form-error">
                            {{ form_errors(form.agreeTerms) }}
                        </div>
                    </div>

                    <input type="hidden" id="formHasError" value="{{ formHasError ?? '0' }}">

                    <button type="submit" class="btn btn-outline-success btn-lg btn-block mt-4">
                        {% trans %}public.account.btn_enregistrer{% endtrans %}
                    </button>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" tabindex="-1" role="dialog" id="terms">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content text-dark font-weight-light">
                <div class="modal-header">
                    <h4 class="modal-title">
                        {% trans %}public.account.terms_modal_title{% endtrans %}
                    </h4>

                    <button type="button"
                            class="close"
                            data-dismiss="modal"
                            aria-label="{{ 'public.account.btn_fermer'|trans }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    {% if termsOfUse %}
                        {{ termsOfUse.description|raw }}
                    {% endif %}
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">
                        {% trans %}public.account.btn_fermer{% endtrans %}
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
