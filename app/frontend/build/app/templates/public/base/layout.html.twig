{% extends "public/base/base.html.twig" %}

{% block title %}
    {% trans %}public.base.accueil{% endtrans %}
{% endblock %}

{% block body %}

    <a href="#public-content" class="skip-link">{% trans %}public.accessibility.skip_to_content{% endtrans %}</a>

    <div class="public-top-actions">
        {{ include('_language_switcher.html.twig') }}
    </div>

    <main class="public-main" id="public-content" tabindex="-1">
    {% if error is defined and error is not null %}
        {% set errorMessage %}
            {% if error.messageKey == "Invalid CSRF token." %}
                {{ 'public.layout.invalid_csrf'|trans }}
            {% elseif error.messageKey in ['login.account_not_found', 'login.account_inactive'] %}
                {{ error.messageKey|trans(error.messageData) }}
            {% else %}
                {{ 'login.invalid_credentials'|trans }}
            {% endif %}
        {% endset %}
        <div class="public-alert-layer" aria-live="assertive">
            <div class="alert alert-danger public-alert" role="alert">
                <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                <span>{{ errorMessage|trim }}</span>
                <button type="button" class="public-alert-close" data-public-alert-close aria-label="{{ 'public.accueil.btn_fermer'|trans }}">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        </div>
    {% endif %}
    {% block content %}{% endblock %}
    </main>

    <!-- Footer -->
    {{ include("public/base/footer.html.twig") }}

{% endblock %}
