{% extends "public/base/base.html.twig" %}

{% block title %}
    {% trans %}public.base.accueil{% endtrans %}
{% endblock %}

{% block body %}

    <a href="#public-content" class="skip-link">{% trans %}public.accessibility.skip_to_content{% endtrans %}</a>

    <div class="public-top-actions">
        {{ include('_language_switcher.html.twig') }}
    </div>

    <main class="public-main" id="public-content" tabindex="-1">
    {% if error is defined and error is not null %}

        <div class="alert alert-danger">
            {#TODO : solution temporaire en attendant d'avoir une gestion des erreurs et logs global #}
            {% if error.messageKey == "Invalid CSRF token." %}
                {% trans %}public.layout.invalid_csrf{% endtrans %}
            {% else %}
                {{ error.messageKey|trans(error.messageData, 'security') }}
            {% endif %}
        </div>
    {% endif %}
    {% block content %}{% endblock %}
    </main>

    <!-- Footer -->
    {{ include("public/base/footer.html.twig") }}

{% endblock %}
