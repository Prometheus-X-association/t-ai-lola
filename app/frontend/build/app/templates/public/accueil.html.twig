{% extends "public/base/layout.html.twig" %}
{% block title %}
    {% trans %}public.accueil.title{% endtrans %}
{% endblock %}

{% block content %}
    {% set registerHasError = formHasError|default('0') == '1' %}
    <div class="login-wrap{% if app.user %} home-wrap{% endif %}{% if registerHasError %} register-has-error{% endif %}" id="login-wrap">
        <div class="login-html">
            <h2>Lola</h2>
            <blockquote class="smallcaps">Laboratoire Ouvert en Learning Analytics</blockquote>

            <div class="hr-sm"></div>
            {% if not app.user %}
                <div class="auth-tabs" role="tablist" aria-label="{{ 'public.accessibility.auth_tabs'|trans }}">
                    <input id="tab-1" type="radio" name="tab" class="sign-in" aria-controls="login-panel"{% if not registerHasError %} checked{% endif %}>
                    <label for="tab-1" class="tab" id="tab-login" role="tab" aria-controls="login-panel" aria-selected="{{ registerHasError ? 'false' : 'true' }}">{% trans %}public.accueil.connexion{% endtrans %}</label>
                    <input id="tab-2" type="radio" name="tab" class="for-pwd" aria-controls="register-panel"{% if registerHasError %} checked{% endif %}>
                    <label for="tab-2" class="tab" id="tab-register" role="tab" aria-controls="register-panel" aria-selected="{{ registerHasError ? 'true' : 'false' }}">{% trans %}public.accueil.inscription{% endtrans %}</label>
                </div>
            {% endif %}

            <div class="login-form">
                {% if app.user %}
                    <div class="logged-user text-center">
                        <i class="fas fa-user-circle mr-2" aria-hidden="true"></i>
                        <em>{{ app.user }}</em>
                    </div>
                    <div class="hr-sm"></div>
                    <div class="group">
                        {% if app.user.termsOfUse or app.user.isAdmin %}
                            <a href="{{ path("dashboard_accueil") }}" class="button button-green btn" target="_blank">
                                <i class="fas fa-cogs mr-2" aria-hidden="true"></i>
                                <span>{% trans %}public.accueil.btn_dashboard{% endtrans %}</span>
                            </a>
                        {% else %}
                            <div class="alert alert-warning" role="alert">
                                {% trans %}public.accueil.terms_update_warning{% endtrans %}<hr>
                                <a href="#" id="link_terms" data-toggle="modal" data-target="#terms_update" class="btn btn-primary btn-sm btn-block">
                                    {% trans %}public.accueil.voir_conditions{% endtrans %}
                                </a>
                            </div>
                        {% endif %}
                    </div>
                    <div class="group">
                        <a href="{{ path("account") }}" class="button button-blue btn">
                            <i class="fas fa-user-circle mr-2" aria-hidden="true"></i>
                            <span>{% trans %}public.accueil.btn_compte{% endtrans %}</span>
                        </a>
                    </div>
                    <div class="hr-sm"></div>
                    <div class="group">
                        <a href="{{ path("app_logout") }}" class="button button-red btn">
                            <i class="fas fa-sign-out-alt mr-2" aria-hidden="true"></i>
                            <span>{% trans %}public.accueil.btn_deconnexion{% endtrans %}</span>
                        </a>
                    </div>
                {% else %}
                    <div class="sign-in-htm" id="login-panel" role="tabpanel" aria-labelledby="tab-login" aria-hidden="{{ registerHasError ? 'true' : 'false' }}">
                        <form method="post" action="{{ path("app_login") }}">
                            <div class="group">
                                <label for="user" class="label">{% trans %}public.accueil.email{% endtrans %}</label>
                                <input id="user" class="input" name="email" type="email" placeholder="{{ 'public.accueil.email'|trans }}" value="{{ last_username ?? "" }}" autocomplete="email" required>
                            </div>
                            <div class="group">
                                <label for="pass" class="label">{% trans %}public.accueil.password{% endtrans %}</label>
                                <input id="pass" class="input" data-type="password" name="password" type="password" placeholder="{{ 'public.accueil.password'|trans }}" autocomplete="current-password" required>
                            </div>
                            <div class="group">
                                <input type="submit" class="button button-blue" value="{{ 'public.accueil.btn_connexion'|trans }}" href="{{ path("homepage") }}" >
                            </div>
                            <div class="hr-sm"></div>
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                        </form>
                        <center>
                            <a href="https://lola.loria.fr" target="_blank" class="text-white public-site-link">
                                <span>{% trans %}public.accueil.btn_lola_site_publique{% endtrans %}</span>
                                <i class="fas fa-external-link-alt" aria-hidden="true"></i>
                            </a>
                        </center>
                    </div>
                    <div class="for-pwd-htm" id="register-panel" role="tabpanel" aria-labelledby="tab-register" aria-hidden="{{ registerHasError ? 'false' : 'true' }}">
                        {% for flashError in app.flashes('verify_email_error') %}
                            <div class="alert alert-danger" role="alert">{{ flashError }}</div>
                        {% endfor %}
                        {{ form_start(form) }}

                        <div class="group">
                            {{ form_label(form.email, 'public.accueil.email'|trans, { 'label_attr': {'class': 'label'} }) }}
                            {{ form_widget(form.email, { 'attr': {'class': 'input', 'autocomplete': 'email'} }) }}
                            <div class="form-error">
                                {{ form_errors(form.email) }}
                            </div>
                        </div>
                        <div class="group">
                            {{ form_label(form.firstname, 'public.accueil.prenom'|trans, { 'label_attr': {'class': 'label'} }) }}
                            {{ form_widget(form.firstname, { 'attr': {'class': 'input', 'autocomplete': 'given-name'} }) }}
                            <div class="form-error">
                                {{ form_errors(form.firstname) }}
                            </div>
                        </div>
                        <div class="group">
                            {{ form_label(form.lastname, 'public.accueil.nom'|trans, { 'label_attr': {'class': 'label'} }) }}
                            {{ form_widget(form.lastname, { 'attr': {'class': 'input', 'autocomplete': 'family-name'} }) }}
                            <div class="form-error">
                                {{ form_errors(form.lastname) }}
                            </div>
                        </div>
                        <div class="group">
                            {{ form_label(form.plainPassword, 'public.accueil.password'|trans, { 'label_attr': {'class': 'label'} }) }}
                            {{ form_widget(form.plainPassword, { 'attr': {'class': 'input', 'autocomplete': 'new-password'} }) }}
                            <div class="form-error">
                                {{ form_errors(form.plainPassword) }}
                            </div>
                        </div>

                        <div class="register-options group">
                            <div class="register-terms">
                                <a href="#" id="link_terms" class="label" data-toggle="modal" data-target="#terms">{% trans %}public.accueil.voir_conditions{% endtrans %}</a>
                                <div class="terms-divider"></div>
                                {{ form_widget(form.agreeTerms, {
                                    'label': 'public.accueil.accepter_conditions'
                                }) }}
                                <div class="form-error">
                                    {{ form_errors(form.agreeTerms) }}
                                </div>
                            </div>
                            <div class="register-captcha">
                                {{ form_label(form.captcha, 'public.accueil.captcha'|trans, { 'label_attr': {'class': 'label'} }) }}
                                <span id="captcha-help" class="sr-only">{% trans %}public.accessibility.captcha_help{% endtrans %}</span>
                                {{ form_widget(form.captcha, { 'attr': {'class': 'input', 'aria-describedby': 'captcha-help', 'autocomplete': 'off'} }) }}
                                <div class="form-error">
                                    {{ form_errors(form.captcha) }}
                                </div>
                            </div>
                        </div>
                        <input type="hidden" id="formHasError" value="{{ formHasError ?? '0' }}">

                        <button type="submit" class="btn btn-outline-success btn-lg btn-block mt-4">{% trans %}public.accueil.inscription{% endtrans %}</button>
                        {{ form_end(form) }}
                    </div>
                {% endif %}

            </div>
        </div>
    </div>

    <div class="modal fade" tabindex="-1" role="dialog" id="terms">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content text-dark font-weight-light">
                <div class="modal-header">
                    <h4 class="modal-title">
                        {% trans %}public.accueil.terms_modal_title{% endtrans %}
                    </h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'public.accueil.btn_fermer'|trans }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                {% if termsOfUse %}
                    {{ termsOfUse.description | raw }}
                {% endif %}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">
                        {% trans %}public.accueil.btn_fermer{% endtrans %}
                    </button>
                </div>
            </div>
        </div>
    </div>
                    
    <div class="modal fade" tabindex="-1" role="dialog" id="terms_update">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content text-dark font-weight-light">
                <div class="modal-header">
                    <h4 class="modal-title">
                        {% trans %}public.accueil.terms_modal_title{% endtrans %}
                    </h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'public.accueil.btn_fermer'|trans }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">   
                    {{ termsOfUse.description | raw }}
                </div>
                <div class="modal-footer">
                    <a href="{{ path('app_terms_update') }}" type="button" class="btn btn-success">
                        {% trans %}public.accueil.btn_accepter{% endtrans %}
                    </a>

                    <button type="button" class="btn btn-danger" data-dismiss="modal">
                        {% trans %}public.accueil.btn_fermer{% endtrans %}
                    </button>
                </div>
            </div>
        </div>
    </div>                                    
{% endblock %}
