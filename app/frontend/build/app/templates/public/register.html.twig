{% extends "public/base/layout.html.twig" %}

{% block title %}
    {% trans %}public.register.title{% endtrans %}
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            <hr>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <h3 class="pb-4 mb-4 font-italic border-bottom">
                {% trans %}public.register.inscription_service{% endtrans %}
            </h3>

            <div class="col-md-12">
                {% for flashError in app.flashes('verify_email_error') %}
                    <div class="alert alert-danger" role="alert">{{ flashError }}</div>
                {% endfor %}

                {{ form_start(form) }}

                {{ form_row(form.email) }}
                {{ form_row(form.firstname) }}
                {{ form_row(form.lastname) }}
                {{ form_row(form.plainPassword) }}

                <div class="row border bg-light pb-2 pt-2 ml-1 mr-1">
                    <div class="col-md-8">
                        {{ form_widget(form.agreeTerms) }}
                        {{ form_label(form.agreeTerms, 'public.register.accepter_conditions') }}

                        <div class="form-error">
                            {{ form_errors(form.agreeTerms) }}
                        </div>

                        <a href="#" id="link_terms" data-toggle="modal" data-target="#terms">
                            {% trans %}public.register.voir_conditions{% endtrans %}
                        </a>
                    </div>

                    <div class="col-md-4 text-right">
                        {{ form_row(form.captcha) }}
                    </div>
                </div>

                <button type="submit" class="btn btn-outline-success btn-lg btn-block mt-4">
                    {% trans %}public.register.btn_register{% endtrans %}
                </button>

                {{ form_end(form) }}
            </div>
        </div>

        <div class="col-md-4">
            {{ include("public/base/right_menu.html.twig") }}
        </div>
    </div>

    <div class="modal fade" tabindex="-1" role="dialog" id="terms">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">
                        {% trans %}public.register.terms_modal_title{% endtrans %}
                    </h4>

                    <button type="button"
                            class="close"
                            data-dismiss="modal"
                            aria-label="{{ 'public.register.btn_fermer'|trans }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    {% if termsOfUse %}
                        {{ termsOfUse.description|raw }}
                    {% endif %}
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">
                        {% trans %}public.register.btn_fermer{% endtrans %}
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}