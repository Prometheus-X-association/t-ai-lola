{% extends "dashboard/base/layout.html.twig" %}
{% block title %}{% trans %}dashboard.algorithm.new.titre{% endtrans %}{% endblock %}

{% block content %}

    <div class="breadcrumb d-flex justify-content-between align-items-center">
        <div class="d-flex">
            <i class="fas fa-code fa-2x sidebar-brand-icon"></i> 
            <span class="text-monospace sidebar-brand-text ml-4 mt-1">{% trans %}dashboard.algorithm.new.titre_2{% endtrans %}</span>
        </div>
        <a href="{{ path('dashboard_algorithm_index') }}" class="btn btn-sm btn-primary">
            <i class="fas fa-arrow-left"></i>
            {% trans %}dashboard.algorithm.new.btn_retour{% endtrans %}
        </a>
    </div>

    <div class="row">
        <div class="col-8">
            {{ include('dashboard/algorithm/_form.html.twig', {'button_label': 'dashboard.algorithm.form.btn_add'}) }}
        </div>
        <div class="col-4">
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-info-circle"></i>
                    {% trans %}dashboard.algorithm.new.card_header{% endtrans %}
                </div>
                <div class="card-body">
                    <h5 class="card-title">{% trans %}dashboard.algorithm.new.card_title{% endtrans %}</h5>
                    <p class="card-text">{% trans %}dashboard.algorithm.new.card_text_1{% endtrans %}</p>

                    <p class="card-text">{% trans %}dashboard.algorithm.new.card_text_2{% endtrans %}</p>

                    <p class="card-text">{% trans %}dashboard.algorithm.new.card_text_3{% endtrans %}</p>
                </div>
            </div>                
        </div>
    </div>


{% endblock %}
